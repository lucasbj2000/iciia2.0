# ---------- Servidor ----------
PORT=3000
NODE_ENV=production
# URL pública con HTTPS. Obligatoria para webhooks de Meta y envío de adjuntos.
PUBLIC_URL=https://crm.tudominio.com

# ---------- Base de datos ----------
DATABASE_URL=postgres://iciia:CAMBIA_ESTA_CLAVE@localhost:5432/iciia_crm
PG_POOL_MAX=10

# ---------- Seguridad ----------
# Generar con: openssl rand -base64 48
JWT_SECRET=CAMBIAR_POR_UNA_CADENA_LARGA_Y_ALEATORIA
JWT_EXPIRA=12h
CORS_ORIGIN=https://crm.tudominio.com

# ---------- Administrador IMPAR (se crea al primer arranque) ----------
ADMIN_USER=admin
ADMIN_PASS=CAMBIA_ESTA_CLAVE_DE_ADMIN
# Esta versión nunca genera empresas demo.
SEED_DEMO=false

# ---------- Adjuntos ----------
MEDIA_DIR=./media
MAX_UPLOAD_MB=16

# ---------- WhatsApp por QR (Baileys) ----------
WA_AUTH_DIR=./auth
PREFIJO_PAIS=595

# ---------- Meta: WhatsApp Cloud API / Messenger / Instagram ----------
GRAPH_VERSION=v21.0
# Token que inventás vos y pegás igual en el panel de Meta
META_VERIFY_TOKEN=CAMBIA_ESTE_TOKEN_DE_VERIFICACION
# App Secret de tu app de Meta (valida la firma de los webhooks)
META_APP_SECRET=
