# Copiá este archivo como «pasarela.env» y completalo. No lo subas a ningún repositorio.
# Dirección del CRM
CRM_URL=https://crm.iciia.tech
# Token que genera el CRM en «Llamadas · Prueba» → Pasarela telefónica (se muestra una sola vez)
PASARELA_TOKEN=
# Opcional: servidor STUN/TURN si el agente y la pasarela están en redes distintas con NAT estricto
# STUN_URL=stun:stun.l.google.com:19302
# TURN_URL=turn:turn.ejemplo.com:3478
# TURN_USUARIO=
# TURN_CLAVE=

# ---------------------------------------------------------------------------
# Modo central IP (Grandstream u otra central SIP). Dejalo vacío para el modo Bluetooth.
# PASARELA_MODO=central
# Central: dirección y puerto SIP, y el interno que usa la pasarela
# SIP_SERVIDOR=190.128.234.106
# SIP_PUERTO=7560
# SIP_USUARIO=801
# Contraseña del interno: se escribe solo acá, nunca en el chat ni en el repositorio
# SIP_CLAVE=
# Puerto SIP local de la pasarela y rango de audio (abrirlos en el firewall del servidor, UDP)
# SIP_PUERTO_LOCAL=5062
# RTP_PUERTO_DESDE=40000
# RTP_PUERTO_HASTA=40100
# Opcional: IP pública del servidor si no se detecta sola
# SIP_IP_PUBLICA=
# Opcional: prefijo de salida de la central (por ejemplo 9) y prefijo internacional
# SIP_PREFIJO_SALIDA=
# SIP_PREFIJO_INTERNACIONAL=00
