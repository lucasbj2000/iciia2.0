# Copiá este archivo como «pasarela.env» y completalo. No lo subas a ningún repositorio.
# Dirección del CRM
CRM_URL=https://crm.iciia.tech
# Token que genera el CRM en «Llamadas · Prueba» → Pasarela telefónica (se muestra una sola vez)
PASARELA_TOKEN=
# Opcional: servidor STUN/TURN si el agente y la pasarela están en redes distintas con NAT estricto
# STUN_URL=stun:stun.l.google.com:19302
# TURN_URL=turn:turn.ejemplo.com:3478
# TURN_USUARIO=
# TURN_CLAVE=
